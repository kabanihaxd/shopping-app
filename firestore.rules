rules_version = '2';

// Правила доступа к базе. Их проверяет сервер Firebase — обойти их из браузера нельзя.
// Выгрузка: npx -y firebase-tools@15.34.1 deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    match /lists/{listId} {
      function isMember() {
        return signedIn() && myEmail() in resource.data.members;
      }

      function isOwner() {
        return signedIn() && resource.data.ownerEmail == myEmail();
      }

      // Видеть список могут только те, кто в members
      allow read: if isMember();

      // Создать можно только свой список, где ты единственный участник
      allow create: if signedIn()
        && request.resource.data.ownerEmail == myEmail()
        && request.resource.data.members == [myEmail()];

      // Код приглашения (inviteCode) — секрет в ссылке-приглашении. Менять его может только владелец.
      function inviteCodeUnchanged() {
        return request.resource.data.get('inviteCode', '') == resource.data.get('inviteCode', '');
      }

      // Вступление по ссылке: человека ещё нет в members, список читать он не может — но может
      // дописать в members только себя, предъявив код из ссылки (joinCode == inviteCode списка).
      // Больше ничего в документе при этом менять нельзя.
      function joiningByInvite() {
        return signedIn()
          && !(myEmail() in resource.data.members)
          && resource.data.get('inviteCode', '') != ''
          && request.resource.data.joinCode == resource.data.inviteCode
          && request.resource.data.members == resource.data.members.concat([myEmail()])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joinCode']);
      }

      // Менять товары может любой участник; менять состав участников и код приглашения — только владелец.
      // Исключение: участник может удалить из members себя (выйти из списка).
      allow update: if (isMember()
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && (isOwner() || inviteCodeUnchanged())
        && (isOwner()
          || request.resource.data.members == resource.data.members
          || request.resource.data.members == resource.data.members.removeAll([myEmail()])))
        || joiningByInvite();

      // Удалить список целиком может только владелец
      allow delete: if isOwner();
    }

    // Личная история добавленных товаров (для подсказок при вводе) — только своя
    match /histories/{email} {
      allow read, write: if signedIn() && email == myEmail();
    }

    // Нікнейми. Прочитать профиль можно, зная email человека (так участники списка видят друг друга
    // по нікнейму), но перебрать все профили нельзя (list запрещён). Менять — только свой.
    match /profiles/{email} {
      allow get: if signedIn();
      allow write: if signedIn()
        && email == myEmail()
        && request.resource.data.keys().hasOnly(['nickname'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 20
        && !request.resource.data.nickname.matches('.*@.*');
    }

    // Кто заходил на сайт. Видит только админ (UID — внутренний номер аккаунта, не email;
    // тот же номер записан в ADMIN_UID в src/app/firebase-config.ts).
    // Записать можно только себя — под своим email.
    match /users/{email} {
      allow read: if signedIn() && request.auth.uid == 'IEZM3sFzcGQZd5ByRNPlHzamfjT2';
      allow write: if signedIn()
        && email == myEmail()
        && request.resource.data.email == myEmail();
    }
  }
}
