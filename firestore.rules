rules_version = '2';

// Правила доступа к базе. Их проверяет сервер Firebase — обойти их из браузера нельзя.
// Выгрузка: npx -y firebase-tools@15.34.1 deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    match /lists/{listId} {
      function isMember() {
        return signedIn() && myEmail() in resource.data.members;
      }

      function isOwner() {
        return signedIn() && resource.data.ownerEmail == myEmail();
      }

      // Видеть список могут только те, кто в members
      allow read: if isMember();

      // Создать можно только свой список, где ты единственный участник
      allow create: if signedIn()
        && request.resource.data.ownerEmail == myEmail()
        && request.resource.data.members == [myEmail()];

      // Менять товары может любой участник; менять состав участников — только владелец.
      // Исключение: участник может удалить из members себя (выйти из списка).
      allow update: if isMember()
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && (isOwner()
          || request.resource.data.members == resource.data.members
          || request.resource.data.members == resource.data.members.removeAll([myEmail()]));

      // Удалить список целиком может только владелец
      allow delete: if isOwner();
    }

    // Кто заходил на сайт. Видит только админ (UID — внутренний номер аккаунта, не email;
    // тот же номер записан в ADMIN_UID в src/app/firebase-config.ts).
    // Записать можно только себя — под своим email.
    match /users/{email} {
      allow read: if signedIn() && request.auth.uid == 'IEZM3sFzcGQZd5ByRNPlHzamfjT2';
      allow write: if signedIn()
        && email == myEmail()
        && request.resource.data.email == myEmail();
    }
  }
}
